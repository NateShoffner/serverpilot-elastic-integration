interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
resource.headers:
  Accept:
    - application/json
auth.basic.user: {{client_id}}
auth.basic.password: {{api_key}}
redact:
  fields: ~
program: |-
  // ServerPilot GET /apps returns the account's complete app inventory in
  // one response, wrapped in a "data" key. The API exposes no pagination
  // parameters and no "changed since" filter, so this is a single unconditional
  // request per poll: want_more is always false and there is no cursor state.
  state.with(
    get(state.url.trim_right("/") + "/apps").as(resp,
      // Success: one event per app.
      (resp.StatusCode == 200) ?
        try(resp.Body.decode_json(), "decode_error").as(body,
          !has(body.decode_error) ?
            {
              // ssl.key, ssl.cert and ssl.cacerts are PEM blobs, and ssl.key is the
              // app's TLS PRIVATE KEY. They must never be indexed. drop() accepts
              // dot-paths, so this reaches into the nested ssl object. The remaining
              // ssl.auto and ssl.force booleans are kept: those are the useful,
              // non-sensitive facts about the certificate configuration.
              "events": body.?data.orValue([]).map(e,
                {
                  "message": e.drop(["ssl.key", "ssl.cert", "ssl.cacerts"]).encode_json(),
                }
              ),
              "want_more": false,
            }
          :
            // 200 with a body that is not JSON, e.g. an intercepting proxy
            // returning an HTML error page.
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": string(resp.Status),
                  "message": "GET /apps: " + string(body.decode_error),
                },
              },
              "want_more": false,
            }
        )
      :
        // Authentication failure. Reported separately from transient failures
        // because retrying cannot fix it: the Client ID or API Key in the policy
        // is wrong and needs an operator change.
        (resp.StatusCode == 401) ?
          {
            "events": {
              "error": {
                "code": string(resp.StatusCode),
                "id": string(resp.Status),
                "message": "GET /apps: " + string(resp.Status) + ": ServerPilot rejected the API credentials. Check the Client ID and API Key in the integration policy; this is a configuration error and will not recover on retry.",
              },
            },
            "want_more": false,
          }
        :
          {
            // Any other non-200 status, including the transient 5xx class.
            "events": {
              "error": {
                "code": string(resp.StatusCode),
                "id": string(resp.Status),
                "message": "GET /apps: " + (
                  (size(resp.Body) != 0) ?
                    string(resp.Body)
                  :
                    string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                ),
              },
            },
            "want_more": false,
          }
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
